  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AchievementManager
  achievements:
  - id: level_start
    title: The Outsider
    description: The village has found its sacrifice. The hunt is on.
  - id: first_blood
    title: First Blood
    description: Get your first kill.
  - id: first_headshoot
    title: Headhunter
    description: Land your first headshot.
  - id: fast_killer
    title: Quick Draw
    description: Eliminate an enemy within the first 30 seconds.
  - id: fully_charged
    title: Hold... Hoooold...
    description: Squeeze every last ounce of power out of your bow.
  - id: stop_running_away
    title: Pacifist
    description: Survive for 60 seconds without getting a kill.
  - id: blood_kill
    title: Blood Bath
    description: Get your first bloody kill.
  - id: electric_kill
    title: Thunderstruck
    description: Get your first electry kill.
  - id: piercing_kill
    title: Armor Piercer
    description: Get your first piercing kill.
  - id: blood_multikill
    title: Bloody Massacre
    description: 'Kill 3 enemies within 3 seconds using blood damage. '
  - id: electric_multikill
    title: Lightning Storm
    description: 'Kill 3 enemies within 3 seconds using electric damage. '
  - id: piercing_multikill
    title: Shish Kebab
    description: Kill 3 enemies within 3 seconds using piercing damage.
  - id: max_souls
    title: Soul Rat
    description: Reach the maximum soul capacity.
  - id: pentakill
    title: Pentakill
    description: Eliminate 5 enemies within 5 seconds.
  - id: environment_barrel
    title: Popcorn Time!
    description: Turn the battlefield into a blazing inferno.
  - id: environment_light
    title: Purifying Radiance
    description: Awaken the ancient circle and blind the unworthy
  - id: environment_water
    title: Wrath of the Storm
    description: Channel the thunder into the waters and paralyze your foes.
  - id: environment_oil
    title: 'Infernal Baptism '
    description: Ignite the corrupted oil and cleanse the earth with fire.
  - id: living_on_the_edge
    title: Tis But a Scratch
    description: 'Who needs a full health bar anyway? '
  - id: no_funds
    title: Healthcare Ain't Free
    description: 'Your soul pouch is empty. Try killing something first! '
  - id: long_shot
    title: From Downtown
    description: 'Eliminate an enemy from more than 30 meters away. '
  - id: the_third_toll
    title: Bells of Salvation
    description: A path is opened, but what horrors lie beyond the gate?
  - id: sensory_overload
    title: Master of Elements
    description: Apply both blood and electric status effects simultaneously.
